# Discord Bot Configuration
# ========================

# Required: Bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Required: Discord Application ID (Client ID)
APP_ID=your_application_id_here

# Optional: Guild ID for instant development slash command syncing.
# Leave blank in production to register slash commands globally.
GUILD_ID=

# Environment: "development" | "production"
ENV=development

# Logging configuration:
# LOG_LEVEL: "DEBUG" | "INFO" | "WARN" | "ERROR"
LOG_LEVEL=INFO

# LOG_FORMAT: "text" | "json"
LOG_FORMAT=text

# HTTP Server Port for health checks (Cubicle / Docker)
PORT=8080

# Optional: Automatically delete registered slash commands when the bot shuts down
REMOVE_COMMANDS_ON_SHUTDOWN=false

# ========================
# Loco AI Chat & Memory Settings
# ========================

# Required for AI chat: Google Gemini API Key
# Get one for free at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Required for AI chat: The Discord Channel ID where Loco AI chats with members
LOCO_CHANNEL_ID=your_chat_channel_id_here

# Optional: Redis URL for chat history persistence.
# For local development with Docker Redis: redis://localhost:6385/0
# Inside Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6385/0

# Max conversation history to keep in memory (default: 15)
MAX_CHAT_HISTORY=15

# Probability (0.0 to 1.0) of Loco chiming into unprompted channel messages (default: 0.40)
CHAT_RESPONSE_CHANCE=0.40
