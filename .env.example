# Discord Bot Configuration
# ========================

# Required: Bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Required: Discord Application ID (Client ID)
APP_ID=your_application_id_here

# Optional: Guild ID for instant development slash command syncing.
# Leave blank in production to register slash commands globally.
GUILD_ID=

# Environment: "development" | "production"
ENV=development

# Logging configuration:
# LOG_LEVEL: "DEBUG" | "INFO" | "WARN" | "ERROR"
LOG_LEVEL=INFO

# LOG_FORMAT: "text" | "json"
LOG_FORMAT=text

# HTTP Server Port for health checks
PORT=8080

# Optional: Automatically delete registered slash commands when the bot shuts down
REMOVE_COMMANDS_ON_SHUTDOWN=false
